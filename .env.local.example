NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser (no NEXT_PUBLIC_ prefix).
# Used for admin operations (creating/deleting employee accounts).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Powers the AI Assistant (Phase 16). Free tier via Google AI Studio. Never expose to the browser.
GEMINI_API_KEY=

# Server-only. Powers Phase 15 scheduled email reports (daily digest + weekly
# report). Get a key at resend.com. Never expose to the browser.
RESEND_API_KEY=

# Optional. Sender shown on scheduled emails, e.g. "MONJEZ <reports@yourdomain.com>".
# Falls back to Resend's shared onboarding@resend.dev sender if unset (works
# immediately, but only deliverable to the email you signed up to Resend with
# until you verify your own sending domain in the Resend dashboard).
RESEND_FROM_EMAIL=

# Server-only. Shared secret Vercel Cron sends back as
# `Authorization: Bearer <value>` when it calls /api/cron/* - set the same
# value here and in the Vercel project's environment variables so those
# routes can tell a real cron invocation apart from a public request.
CRON_SECRET=

# Optional. Where Phase 17 plan-upgrade requests get emailed via the same
# Resend helper (uses RESEND_API_KEY above). If unset, upgrade requests are
# still recorded in plan_upgrade_requests, just not emailed to anyone.
SUPPORT_EMAIL=

# Server-only. The one account allowed to view /dashboard/platform (the
# cross-tenant list of every organization on the platform) - see
# requirePlatformOwner in src/lib/actions/guards.ts. Unset means nobody can
# see that page, not "everyone can".
PLATFORM_OWNER_EMAIL=
